NODE_ENV=development
PORT=3001
HOST=0.0.0.0
STORAGE_DIR=../../data/files
DATABASE_URL=postgres://mycloud:mycloud_dev_pass@127.0.0.1:5432/mycloud
WEB_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
MAX_UPLOAD_BYTES=52428800
DEFAULT_QUOTA_BYTES=1073741824
ALLOWED_MIME_PREFIXES=image/,text/,application/pdf,application/zip,application/json,video/,audio/,application/vnd.
ADMIN_EMAIL=admin@mycloud.local
ADMIN_PASSWORD=ChangeThisAdminPassword123!
TRUST_PROXY=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
